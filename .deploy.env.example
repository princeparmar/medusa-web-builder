# Production deploy / server setup (gitignored as .deploy.env).
# Copy: cp .deploy.env.example .deploy.env
#
# Same pattern as vyaparnext: Next.js + Postgres + PM2 (no Docker).
# Cloudflare: A record for app.vyaparnext.com → SERVER_IP, proxied.
# SSL/TLS mode: Full (origin uses self-signed cert).

# --- SSH ---
SERVER_IP=138.252.200.235
SERVER_USER=root
SERVER_PASSWORD=

# --- App ---
APP_NAME=medusa-web-builder
DOMAIN=app.vyaparnext.com
SITE_URL=https://app.vyaparnext.com

# --- Runtime ---
WEB_PORT=8020
DEPLOY_ROOT=~/deploy/medusa-web-builder
REMOTE_WEB_DIR=~/deploy/medusa-web-builder/web
WEB_PM2_NAME=medusa-web-builder-web

# --- Postgres (created by setup-server on the host) ---
DB_NAME=medusa_web_builder
DB_USER=mwb
# DB_PASSWORD=  # auto-generated on setup-server if empty

# --- SSL ---
# SSL_DIR=/etc/ssl/smartbytelabs
# SSL_BASENAME=app-vyaparnext

# --- App secrets ---
AUTH_SECRET=
ENCRYPTION_KEY=

# Catalog media (optional)
CATALOG_S3_BUCKET=
CATALOG_S3_REGION=ap-south-1
CATALOG_S3_ACCESS_KEY_ID=
CATALOG_S3_SECRET_ACCESS_KEY=
CATALOG_S3_PUBLIC_URL=

# First super admin (make create-admin)
ADMIN_EMAIL=admin@vyaparnext.com
ADMIN_PASSWORD=
